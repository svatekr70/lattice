# Lattice demo — routing /api/* na api.php (Apache / Wedos).
# Klient volá /api/presets a /api/defaults; tady se to přesměruje na api.php,
# které endpoint pozná z cesty. QSA zachová query (?grid=…, ?id=…).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/(presets|defaults)$ api.php [QSA,L]
</IfModule>

# JSON úložiště (složka data/) nikdy neservírovat přímo.
<IfModule mod_authz_core.c>
  <Directory "data">
    Require all denied
  </Directory>
</IfModule>

# Demo/dokumentace importují ESM moduly přímo z /src/ (bez verzování). Aby po
# nasazení nové verze prohlížeč nedržel staré moduly z cache, necháme JS/CSS
# revalidovat: "no-cache" = smí se kešovat, ale před použitím se vždy ověří u
# serveru (podmíněný GET → 304 když se nezměnilo, jinak čerstvá 200).
# Knihovny konzumují přes jsDelivr @vX (verzované), takže tohle je jen pro demo web.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
